      <aliases enabled='yes' />
      <column caption='Churn rate' datatype='real' name='[Calculation_4687559392182272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Churn_Flag]) / COUNTD([customerID])' />
      </column>
      <column caption='Net revenue at risk' datatype='real' name='[Calculation_4687559392591873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Predicted_Churn] = 1 THEN[MonthlyCharges] ELSE 0 END' />
      </column>
      <column caption='ARPU' datatype='real' name='[Calculation_4687559393038338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([MonthlyCharges])' />
      </column>
      <column caption='TENURE GROUP SORT' datatype='integer' name='[Calculation_4687559393234947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [TenureGroup]&#13;&#10;  WHEN &quot;0-1 Year&quot;   THEN 1&#13;&#10;  WHEN &quot;1-2 Years&quot;  THEN 2&#13;&#10;  WHEN &quot;2-3 Years&quot;  THEN 3&#13;&#10;  WHEN &quot;3-4 Years&quot;  THEN 4&#13;&#10;  WHEN &quot;4-5 Years&quot;  THEN 5&#13;&#10;  WHEN &quot;5+ Years&quot;   THEN 6&#13;&#10;END' />
      </column>
      <column caption='HIGH RISK FLAG' datatype='boolean' name='[Calculation_4687559393464324]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Churn_Probability] &gt;= 0.6' />
      </column>
      <column caption='CHURN LABEL' datatype='string' name='[Calculation_4687559393587205]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Churn] = &quot;Yes&quot; THEN &quot;Churned&quot; ELSE &quot;Retained&quot; END' />
      </column>
      <column caption='Target base' datatype='real' name='[Calculation_4687559395487750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Contract] = &quot;Month-to-month&quot; AND [Predicted_Churn] = 1&#13;&#10;THEN [MonthlyCharges]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Campaign cost' datatype='real' name='[Calculation_4687559395766279]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4687559395487750]) * ([Parameters].[Parameter 1] / 100) * ([Parameters].[Parameter 2]  / 100)' />
      </column>
      <column caption='Revenue Saved ' datatype='real' name='[Calculation_4687559396044808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4687559395487750]) * ([Parameters].[Parameter 2] / 100) * 0.85' />
      </column>
      <column caption='Net ROI' datatype='real' name='[Calculation_4687559396413449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4687559396044808] - [Calculation_4687559395766279]' />
      </column>
      <column caption='jitter' datatype='real' name='[Calculation_4687559412133898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANDOM()' />
      </column>
      <column caption='revenue at risk' datatype='real' name='[Calculation_4687559424065548]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4687559392591873])' />
      </column>
      <column caption='campaign cost' datatype='real' name='[Calculation_4687559424163853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-[Calculation_4687559395766279]' />
      </column>
      <column caption='revenue saved' datatype='real' name='[Calculation_4687559424245774]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-[Calculation_4687559396044808]' />
      </column>
      <column caption='net all risk' datatype='integer' name='[Calculation_4687559424315407]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='After campaign' datatype='real' name='[Calculation_4687559427010578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4687559424065548]-[Calculation_4687559396044808]' />
      </column>
      <column caption='Before campaign' datatype='real' name='[Calculation_4687559430148115]' role='measure' type='quantitative'>
