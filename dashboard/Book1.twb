    <worksheet name='retention impact'>
      <table>
        <view>
          <datasources>
            <datasource caption='churn_scored.csv (Multiple Connections)' name='federated.0lqzjfw00e4uwl1774z2b1212a4m' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Acceptance rate %' datatype='real' default-format='*0 decimals, suffix %' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='30.'>
              <calculation class='tableau' formula='30.' />
              <range granularity='5.0' max='60.0' min='10.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0lqzjfw00e4uwl1774z2b1212a4m'>
            <column caption='Net revenue at risk' datatype='real' name='[Calculation_4687559392591873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Predicted_Churn] = 1 THEN[MonthlyCharges] ELSE 0 END' />
            </column>
            <column caption='Target base' datatype='real' name='[Calculation_4687559395487750]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Contract] = &quot;Month-to-month&quot; AND [Predicted_Churn] = 1&#13;&#10;THEN [MonthlyCharges]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Revenue Saved ' datatype='real' name='[Calculation_4687559396044808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4687559395487750]) * ([Parameters].[Parameter 2] / 100) * 0.85' />
            </column>
            <column caption='revenue at risk' datatype='real' name='[Calculation_4687559424065548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4687559392591873])' />
            </column>
            <column caption='After campaign' datatype='real' name='[Calculation_4687559427010578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4687559424065548]-[Calculation_4687559396044808]' />
            </column>
            <column caption='Before campaign' datatype='real' name='[Calculation_4687559430148115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4687559424065548]' />
            </column>
            <column datatype='string' name='[Contract]' role='dimension' type='nominal' />
            <column caption='Monthly Charges' datatype='real' name='[MonthlyCharges]' role='measure' type='quantitative' />
            <column caption='Predicted Churn' datatype='integer' name='[Predicted_Churn]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_4687559392591873]' derivation='Sum' name='[sum:Calculation_4687559392591873:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4687559427010578]' derivation='User' name='[usr:Calculation_4687559427010578:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4687559430148115]' derivation='User' name='[usr:Calculation_4687559430148115:qk]' pivot='key' type='quantitative' />
